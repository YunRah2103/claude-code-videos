      {"who": "hero", "move": "block", "at": 114, "align": "key", "mirror": true, "speed": 1.2}],
      "contact": {"attacker": "opp", "defender": "hero", "target": "guard", "hitstop": 2, "size": 0.7, "fx": "fire"}},
    {"n": 6, "label": "opponent jab-feint, hero ducks", "actions": [
